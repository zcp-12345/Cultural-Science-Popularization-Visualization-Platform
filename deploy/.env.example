# 复制为 deploy/.env 并填写（docker compose 会自动读取本目录的 .env）。
# 不要提交 .env 到 git（已被 .gitignore 忽略）。

# 后端 API 域名：先在域名 DNS 加一条 A 记录指向本服务器公网 IP（例如 api.example.com）
API_DOMAIN=api.example.com

# PostgreSQL（跑在容器内，无需单独安装）。
# 密码只用字母和数字，别用 @ : / 等特殊字符（会出现在连接串里）。
POSTGRES_USER=app
POSTGRES_PASSWORD=改成你自己的强密码
POSTGRES_DB=archaeology

# 后端 JWT 签名密钥：随便打一段够长的随机字符串
JWT_SECRET=改成一段长随机字符串

# AI 密钥：和本机 backend/.env 里的一样
DEEPSEEK_API_KEY=sk-...
EMBEDDING_API_KEY=硅基流动的key

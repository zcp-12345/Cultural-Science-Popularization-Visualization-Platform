# 平台级忽略（frontend/ 内另有更细的 .gitignore）

# 依赖与构建产物
node_modules/
dist/
dist-ssr/

# 环境与本地配置
.env
.env.*
!.env.example
*.local

# 系统与临时文件
.DS_Store
Thumbs.db
_plan_extracted.txt
*.zip

# 覆盖率与类型产物
coverage/
*.tsbuildinfo

# Python（backend/ 与 tools/）
.venv/
__pycache__/
.pytest_cache/
*.db
*.egg-info/

# RAG 向量索引（由 kb/docs.json 重建，首次 /ai/chat 时懒生成）
chroma_db/

# 第三方字形/字体源（上游 git 仓库，重新构建时按 CREDITS.md 再 clone，不随仓库分发）
assets/glyphs-src/

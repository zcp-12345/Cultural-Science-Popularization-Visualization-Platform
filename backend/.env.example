# 复制为 .env 使用
DATABASE_URL=sqlite:///./dev.db
JWT_SECRET=change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# CORS_ORIGINS 需用 JSON 数组字符串覆盖（默认已含 localhost:5173）：
# CORS_ORIGINS=["http://localhost:5173","https://cultural-science-popularization-visualization-platform.pages.dev"]

# AI 层（Phase 3）：密钥仅后端，绝不进 VITE_*
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
AI_ENABLED=true
# RAG（Phase 3 M2）
RAG_TOP_K=3
RAG_SIM_THRESHOLD=0.35
KB_SOURCE=app/kb/docs.json
KB_PERSIST_DIR=./chroma_db

# 复制为 .env 使用
DATABASE_URL=sqlite:///./dev.db
JWT_SECRET=change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# CORS_ORIGINS 需用 JSON 数组字符串覆盖（默认已含 localhost:5173）：
# CORS_ORIGINS=["http://localhost:5173","https://cultural-science-popularization-visualization-platform.pages.dev"]

# AI 层（Phase 3）：密钥仅后端，绝不进 VITE_*
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
AI_ENABLED=true
# RAG（Phase 3 M2）
RAG_TOP_K=3
RAG_SIM_THRESHOLD=0.35
KB_SOURCE=app/kb/docs.json
KB_EVAL_SOURCE=app/kb/eval.json
KB_PERSIST_DIR=./chroma_db

# 云端 embedding（Phase 4）：provider=cloud 且配 key 时走 OpenAI 兼容接口（默认硅基流动），
# 否则回退本地 fastembed。切换 provider 后删除 chroma_db 重建索引。
EMBEDDING_PROVIDER=local
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# 限流（Phase 4）：/ai/chat 按 IP 滑动窗口限流；requests<=0 表示不限流。
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_TRUST_XFF=true

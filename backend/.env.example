# 复制为 .env 使用（本地开发）。生产环境（Render）由 render.yaml 的 envVars 注入，不放本文件。

# ---- 数据库 ----
# 本地开发：SQLite（默认）
DATABASE_URL=sqlite:///./dev.db
# 生产（Neon PostgreSQL）：把 <...> 换成 Neon 控制台给的连接串，结尾保留 ?sslmode=require
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<ep-host>/<dbname>?sslmode=require

# ---- 鉴权（M3）----
JWT_SECRET=change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# 生产 HTTPS 必须 true（refresh cookie 带 Secure）
COOKIE_SECURE=false
# 本地同源开发用 lax；生产跨域（pages.dev → onrender.com）必须 none（配合 Secure）
COOKIE_SAMESITE=lax

# ---- CORS（JSON 数组字符串，覆盖默认的 localhost:5173）----
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://cultural-science-popularization-visualization-platform.pages.dev","https://cultural-science-popularization-visualization-platfo-eitb8q9xo.vercel.app"]

# ---- AI 层（Phase 3）：密钥仅后端，绝不进 VITE_* ----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
AI_ENABLED=true

# ---- RAG（Phase 3 M2）----
RAG_TOP_K=3
RAG_SIM_THRESHOLD=0.35
KB_SOURCE=app/kb/docs.json
KB_EVAL_SOURCE=app/kb/eval.json
KB_PERSIST_DIR=./chroma_db

# ---- 云端 embedding（Phase 4）----
# 生产用 cloud（避免在 Render 下载 130MB 本地模型）；本地无 key 时自动回退 fastembed。
# 切换 provider 会改变向量维度，需删除 chroma_db 重建索引。
EMBEDDING_PROVIDER=local
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ---- 限流（Phase 4）：/ai/chat 按 IP 滑动窗口限流；requests<=0 表示不限流 ----
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_TRUST_XFF=true
